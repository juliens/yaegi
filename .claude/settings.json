{
  "env": {
    "GOPATH": "/Users/juliensalleyron/dev/go",
    "GOMODCACHE": "/Users/juliensalleyron/go/pkg/mod"
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "/Users/juliensalleyron/Library/Caches/go-build",
        "/Users/juliensalleyron/go/pkg/mod"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")\"/scripts/fork-guard.sh claude-hook",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
